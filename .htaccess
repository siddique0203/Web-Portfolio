# ===== Portfolio: Apache / LiteSpeed server rules =====
DirectoryIndex index.html index.php
Options -Indexes
ServerSignature Off
ErrorDocument 404 /404.html

# --- Never serve secrets or internals (.env, config, git, logs, docs) ---
<FilesMatch "^(\.env.*|\.git.*|\.ht.*|config\.php|composer\.(json|lock)|.*\.(md|log|bak|sql))$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# --- Security headers ---
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# --- Compression ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml
</IfModule>

# --- Browser caching (bump the ?v= number in index.html when you change CSS/JS) ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType application/pdf "access plus 1 day"
</IfModule>

# --- Force HTTPS: uncomment ONLY after your SSL certificate is active ---
